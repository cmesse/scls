#!/usr/bin/env bash
SCLS_DIR="$(cd "$(dirname "$0")" && pwd)"

# Read flavor.conf (YAML). Required keys: flavor. Optional: python,
# forced_packages.  We always use python3 to parse the conf so we don't
# need a chicken-and-egg with the optional `python:` field.
FLAVOR_CONF="$SCLS_DIR/flavor.conf"
if [ ! -f "$FLAVOR_CONF" ]; then
    echo "Error: No flavor.conf found in $SCLS_DIR"
    echo "Create one with at least:"
    echo "  flavor: <name>"
    exit 1
fi

# Parse flavor.conf into shell variables. Fall back to legacy line-based
# format if it isn't valid YAML (one-line "<flavor>", optional second line
# "<python>") so existing setups don't break.
_conf_vars="$(python3 - "$FLAVOR_CONF" <<'PYEOF'
import sys, yaml
path = sys.argv[1]
with open(path) as f:
    text = f.read()
data = None
try:
    data = yaml.safe_load(text)
except yaml.YAMLError:
    data = None
if not isinstance(data, dict):
    # Legacy line-based format: line 1 = flavor, line 2 = optional python
    lines = [l.strip() for l in text.splitlines() if l.strip() and not l.lstrip().startswith('#')]
    data = {}
    if lines:
        data['flavor'] = lines[0]
    if len(lines) > 1:
        data['python'] = lines[1]
flavor = (data.get('flavor') or '').strip()
python = (data.get('python') or '').strip()
gcc_toolset = data.get('gcc_toolset')
if gcc_toolset is not None:
    gcc_toolset = str(gcc_toolset).strip()
else:
    gcc_toolset = ''
extra = data.get('extra_packages') or []
if not isinstance(extra, list):
    extra = []
print(f'FLAVOR={flavor!r}')
print(f'PYTHON={python!r}')
print(f'GCC_TOOLSET={gcc_toolset!r}')
print(f'EXTRA_PACKAGES=({" ".join(repr(p) for p in extra)})')
PYEOF
)"
if [ $? -ne 0 ] || [ -z "$_conf_vars" ]; then
    echo "Error: failed to parse $FLAVOR_CONF"
    exit 1
fi
eval "$_conf_vars"
PYTHON="${PYTHON:-python3}"

if [ -z "$FLAVOR" ]; then
    echo "Error: flavor.conf has no flavor: field"
    exit 1
fi

# If gcc_toolset is set, source the Red Hat toolset's enable script so the
# toolset compilers and binutils are first in PATH. Also export
# SCLS_GCC_TOOLSET so the python builder can rewrite bootstrap_compilers.
if [ -n "$GCC_TOOLSET" ]; then
    TOOLSET_ENABLE="/opt/rh/gcc-toolset-${GCC_TOOLSET}/enable"
    if [ ! -f "$TOOLSET_ENABLE" ]; then
        echo "Error: gcc_toolset=${GCC_TOOLSET} requested but $TOOLSET_ENABLE not found"
        echo "       Install with: sudo dnf install gcc-toolset-${GCC_TOOLSET}"
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$TOOLSET_ENABLE"
    export SCLS_GCC_TOOLSET="$GCC_TOOLSET"
fi
if [ ! -f "$SCLS_DIR/flavors/${FLAVOR}.yaml" ]; then
    echo "Error: Flavor '${FLAVOR}' not found (no flavors/${FLAVOR}.yaml)"
    exit 1
fi

# Determine if RPM mode applies
USE_RPM=false
if [ "$(uname)" = "Linux" ] && [ -f /etc/system-release ]; then
    release=$(cat /etc/system-release)
    if echo "$release" | grep -qiE '(Rocky|Red Hat|AlmaLinux|CentOS).* (9|10)\.'; then
        USE_RPM=true
    fi
    if echo "$release" | grep -qiE '(Amazon).* (2023)\.'; then
	USE_RPM=true
    fi
fi

# Determine if DEB mode applies. Check /etc/os-release (standard on Debian
# family) rather than /etc/debian_version alone so we also catch derivatives
# that set ID_LIKE=debian (Mint, Pop!_OS, elementary, etc.). RPM mode wins
# if both somehow match.
USE_DEB=false
if [ "$USE_RPM" != true ] && [ "$(uname)" = "Linux" ] && [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    case ":${ID:-}:${ID_LIKE:-}:" in
        *:debian:*|*:ubuntu:*)
            USE_DEB=true
            ;;
    esac
fi

# Handle commands that don't need a package name
case "$1" in
    list)
        $PYTHON python/unix_builder.py --flavor "$FLAVOR" --list
        exit 0
        ;;
    order)
        $PYTHON python/build_order.py "$SCLS_DIR/recipes" --flavor "$FLAVOR"
        exit 0
        ;;
    check-updates)
        shift
        $PYTHON python/update_checker.py --recipes-dir "$SCLS_DIR/recipes" "$@"
        exit 0
        ;;
    release)
        # Back-compat shim: 'scls release' now just runs the same code path as
        # 'scls build scls-release', which is format-aware (RPM on RHEL/AL2023,
        # DEB on Ubuntu — the Debian output is named scls-archive-keyring per
        # convention but the user-facing handle stays scls-release).
        exec "$0" build scls-release
        ;;
esac

# Commands that require a package name
if [ -z "$2" ]; then
    echo "Usage: scls <command> <package>"
    echo "       scls <command> next        (build/install next unbuilt package)"
    echo "       scls build all             (build+install every package for the flavor)"
    echo "       scls list"
    echo ""
    echo "Active flavor: $FLAVOR"
    exit 1
fi

PACKAGE="$2"

# `scls build all` — build+install every package for the active flavor in
# dependency order. Stops on the first failure. Prompts for sudo once and
# keeps the credential warm via a background `sudo -v` refresher so the
# per-install apt-get / dnf call never prompts mid-loop.
if [ "$1" = "build" ] && [ "$PACKAGE" = "all" ]; then
    if [ "$USE_DEB" = true ] || [ "$USE_RPM" = true ]; then
        echo "Refreshing sudo credentials (required for per-package install)..."
        if ! sudo -v; then
            echo "Error: could not acquire sudo credentials." >&2
            exit 1
        fi
        # Background keepalive: refresh every 60s, exit quietly once the
        # cache can't be refreshed non-interactively (shouldn't happen
        # while the parent is alive, but belt-and-braces for shell exit).
        ( while true; do
              sudo -n -v 2>/dev/null || exit 0
              sleep 60
          done ) &
        KEEPALIVE_PID=$!
        # Clean up on any exit path: success, build error, Ctrl-C, SIGTERM.
        # shellcheck disable=SC2064
        trap "kill $KEEPALIVE_PID 2>/dev/null; wait $KEEPALIVE_PID 2>/dev/null" EXIT INT TERM
    fi

    # Loop order: install-before-build. On each iteration we first ask
    # for any package that is built-but-not-installed (e.g. a prior run
    # aborted mid-install) and install it; only when nothing is pending
    # install do we fall through to build the next unbuilt package. This
    # lets `scls build all` resume cleanly after a failed install step,
    # where get_next_unbuilt_package would otherwise skip the package
    # because its local marker + artifact still exist.
    STEPS=0
    while :; do
        NEXT=$($PYTHON -c "
import sys; sys.path.insert(0, '$SCLS_DIR/python')
from build_order import (
    get_next_uninstalled_package, get_next_unbuilt_package
)
from build_common import load_flavor
prefix = load_flavor('$FLAVOR')['prefix']
# Priority: finish installing anything that's been built first. If
# nothing is pending install, advance to the next unbuilt package.
pkg = get_next_uninstalled_package('$SCLS_DIR/recipes', '$FLAVOR', prefix)
if pkg:
    print('install', pkg)
    sys.exit(0)
pkg = get_next_unbuilt_package('$SCLS_DIR/recipes', '$FLAVOR', prefix)
if pkg:
    print('build', pkg)
    sys.exit(0)
sys.exit(1)
" 2>/dev/null)
        if [ $? -ne 0 ] || [ -z "$NEXT" ]; then
            break
        fi
        ACTION=$(echo "$NEXT" | awk '{print $1}')
        PKG=$(echo "$NEXT" | awk '{print $2}')
        N=$((STEPS + 1))

        if [ "$ACTION" = "build" ]; then
            echo ""
            echo "================================================================"
            echo "  [$N] build: $PKG (flavor=$FLAVOR)"
            echo "================================================================"
            if ! "$SCLS_DIR/scls" build "$PKG"; then
                echo "" >&2
                echo "Error: 'scls build $PKG' failed after $STEPS successful steps." >&2
                echo "Fix the issue and re-run 'scls build all' to resume." >&2
                exit 1
            fi
            # Falls through to the next iteration, which will see this
            # package as built-but-uninstalled and install it.
        else  # install
            echo ""
            echo "================================================================"
            echo "  [$N] install: $PKG"
            echo "================================================================"
            if ! "$SCLS_DIR/scls" install "$PKG"; then
                echo "" >&2
                echo "Error: 'scls install $PKG' failed after $STEPS successful steps." >&2
                echo "Package artifact is in work/pkgs (deb) or rpmbuild/RPMS (rpm);" >&2
                echo "inspect the apt/dnf output, fix, and re-run 'scls build all'." >&2
                exit 1
            fi
        fi

        STEPS=$((STEPS + 1))
    done

    echo ""
    echo "================================================================"
    echo "  Done. Completed $STEPS build/install steps for flavor '$FLAVOR'."
    echo "================================================================"
    exit 0
fi

# Resolve "next" to the appropriate next package
if [ "$PACKAGE" = "next" ]; then
    if [ "$1" = "install" ] && { [ "$USE_RPM" = true ] || [ "$USE_DEB" = true ]; }; then
        # For "install next": find the next built-but-not-installed package
        PACKAGE=$($PYTHON -c "
import sys; sys.path.insert(0, '$SCLS_DIR/python')
from build_order import get_next_uninstalled_package
from build_common import load_flavor
prefix = load_flavor('$FLAVOR')['prefix']
pkg = get_next_uninstalled_package('$SCLS_DIR/recipes', '$FLAVOR', prefix)
if pkg: print(pkg)
else: sys.exit(1)
" 2>/dev/null)
        if [ $? -ne 0 ] || [ -z "$PACKAGE" ]; then
            echo "All built packages are already installed."
            exit 0
        fi
    else
        # For "build next" and others: find the next unbuilt package
        PACKAGE=$($PYTHON -c "
import sys; sys.path.insert(0, '$SCLS_DIR/python')
from build_order import get_next_unbuilt_package
from build_common import load_flavor
prefix = load_flavor('$FLAVOR')['prefix']
pkg = get_next_unbuilt_package('$SCLS_DIR/recipes', '$FLAVOR', prefix)
if pkg: print(pkg)
else: sys.exit(1)
" 2>/dev/null)
        if [ $? -ne 0 ] || [ -z "$PACKAGE" ]; then
            echo "All packages are already built."
            exit 0
        fi
    fi
    if [ "$PACKAGE" = "_meta" ]; then
        echo "Next package: scls-${FLAVOR} (flavor meta-package)"
    else
        echo "Next package: $PACKAGE"
    fi
fi

if [ "$USE_RPM" = true ]; then
    # Translate subcommands into rpm_builder.py flags
    RPM_EXTRA_ARGS=""
    case "$1" in
        build)   ;;  # default behavior: full build
        spec)    RPM_EXTRA_ARGS="--spec-only" ;;
        install) RPM_EXTRA_ARGS="--install" ;;
        *)       RPM_EXTRA_ARGS="$1" ;;
    esac
    # Forward any extra flags after the package name to rpm_builder.py.
    # (extra_packages override and gcc-toolset are read from flavor.conf
    # by rpm_builder itself, no CLI plumbing required.)
    $PYTHON python/rpm_builder.py --package "$PACKAGE" --flavor "$FLAVOR" $RPM_EXTRA_ARGS "${@:3}"
elif [ "$USE_DEB" = true ]; then
    # Translate subcommands into deb_builder.py flags. deb_builder's default
    # (no positional args) is the full build/install/deb pipeline, matching
    # what rpm_builder's bare invocation does.
    #
    # We build an explicit EXTRA array from "${@:3}" because bash's slice
    # expansion emits a single empty-string argument when nothing follows,
    # which argparse then rejects against the choices= list.
    EXTRA=()
    if [ $# -gt 2 ]; then
        EXTRA=( "${@:3}" )
    fi
    case "$1" in
        build)
            $PYTHON python/deb_builder.py --package "$PACKAGE" --flavor "$FLAVOR" "${EXTRA[@]}"
            ;;
        install)
            $PYTHON python/deb_builder.py --package "$PACKAGE" --flavor "$FLAVOR" --install "${EXTRA[@]}"
            ;;
        spec)
            echo "Error: 'scls spec' has no DEB equivalent. The control file"
            echo "       is rendered into the staged buildroot during a full"
            echo "       build; run 'scls build <pkg>' and inspect"
            echo "       work/build/destdir/DEBIAN/control."
            exit 1
            ;;
        *)
            # Pass through unrecognized subcommands as positional pipeline
            # steps so e.g. 'scls deb <pkg>' or 'scls test <pkg>' still work.
            $PYTHON python/deb_builder.py --package "$PACKAGE" --flavor "$FLAVOR" "$1" "${EXTRA[@]}"
            ;;
    esac
else
    $PYTHON python/unix_builder.py --package "$PACKAGE" --flavor "$FLAVOR" $1 "${@:3}"
fi

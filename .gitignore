# HSL is proprietary (STFC license): its sources and anything built from them
# must never be committed, wherever they land in the tree. What is public is
# SCLS's own build tooling (scripts/build_libhsl.py, scripts/hsl/) and docs.
# Patterns cover tarballs, unpacked trees and built libraries of every HSL
# package name in doc/HSL_BUILD.md, with or without the hsl_ prefix.
coinhsl*
hsl-galahad*
hsl_m[a-z][0-9]*
ma[0-9][0-9]-*
mc[0-9][0-9]-*
libcoinhsl.*
libhsl.*

scls.html
llms.txt
robots.txt
sitemap.xml

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Publish endpoint: site infrastructure (hostname, upload account), never committed.
publish.conf

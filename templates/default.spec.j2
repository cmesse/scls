#######################################################################
# SCLS {{ flavor.name }} - {{ package_name }}                        #
#######################################################################

%define prefix {{ prefix }}
%define scls_name {{ scls_name }}

# Disable debuginfo/debugsource package generation — SCLS installs into a
# non-standard prefix so the debug packages are not useful and extracting
# them is very slow.
%global debug_package %{nil}

# SCLS installs into a non-standard prefix (/opt/scls/...). EL10's
# check-rpaths flags these as "invalid" (0x0002). Some packages (e.g. VTK)
# also place $ORIGIN after the absolute rpath (0x0008). Allow all three.
%global __brp_check_rpaths QA_RPATHS=$(( 0x0001 | 0x0002 | 0x0008 )) /usr/lib/rpm/check-rpaths

{% if flavor.nvidia %}
%define cuda {{ cuda }}
%define gpu {{ nv_gpu_target }}
{% endif %}

Name:           %{scls_name}
Version:        {{ version }}
Release:        {{ release }}%{?dist}
Summary:        {{ summary or (description | replace('\n', ' ') | truncate(70)) }}

License:        {{ license }}
URL:            {{ homepage }}
Source0:        {{ source_url }}
{% for tsrc in test_sources %}
Source{{ loop.index }}:        {{ tsrc.url }}
{% endfor %}
{% for patch in patches %}
Patch{{ patch.number }}:         {{ patch.file }}
{% endfor %}

# Build requirements
{% for req in build_requires %}
BuildRequires:  {{ req }}
{% endfor %}

# Runtime requirements
{% for req in requires %}
Requires:       {{ req }}
{% endfor %}


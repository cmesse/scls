{% for setup_cmd in pre_build_setup %}
{{ setup_cmd }}
{% endfor %}
{{ path_setup }}
{% if not skip_compiler_env %}
{% if features.mpi %}
export CC=mpicc
export CXX=mpicxx
export FC=mpifort
export F77=mpifort
{% else %}
export CC={{ flavor.compilers.cc }}
export CXX={{ flavor.compilers.cxx }}
export FC={{ flavor.compilers.fc }}
export F77={{ flavor.compilers.fc }}
{% endif %}
export LDFLAGS="{{ ldflags }}"
{% endif %}

{% if install_pre_commands %}
# Pre-install commands
{% for cmd in install_pre_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

{% if install_commands %}
# Custom install commands
{% for cmd in install_commands %}
{{ cmd }}
{% endfor %}
{% elif configure_type == 'autotools' %}
%make_install{% if install_args %} {{ install_args | join(' ') }}{% endif %}

{% elif configure_type == 'cmake' %}
cd build && make install DESTDIR=%{buildroot}{% if install_args %} {{ install_args | join(' ') }}{% endif %}
{% else %}
make install DESTDIR=%{buildroot}{% if install_args %} {{ install_args | join(' ') }}{% endif %}

{% endif %}

{% if install_post_commands %}
# Post-install commands
{% for cmd in install_post_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

# Remove libtool archives
find %{buildroot} -name '*.la' -delete 2>/dev/null || true

# Remove info directory file - managed by system
rm -rf %{buildroot}%{prefix}/share/info

# Create SCLS registry entry
mkdir -p %{buildroot}%{prefix}/share/scls/registry
cat > %{buildroot}%{prefix}/share/scls/registry/{{ package_name }}.yaml << 'EOF'
name: {{ package_name }}
version: {{ version }}
license: {{ license }}
summary: {{ summary }}
dependencies:
{% for dep in package_dependencies %}
  - {{ dep }}
{% endfor %}
cflags: {{ registry_cflags }}
ldflags: {{ registry_ldflags }}
features:
  fortran: {{ 'true' if features.fortran else 'false' }}
  openmp: {{ 'true' if features.openmp else 'false' }}
  mpi: {{ 'true' if features.mpi else 'false' }}
  math: {{ 'true' if features.math else 'false' }}
has_pc_file: false
EOF

{% if rpm_files_auto %}
# Auto-generate file list from BUILDROOT
# List all files (not directories) under the prefix
find %{buildroot}%{prefix} -type f -o -type l | sed 's|^%{buildroot}||' > %{_builddir}/filelist.txt
# Claim shared-ownership (%dir) on subdirs of lib/ and share/. Using %dir lets
# multiple packages coexist under paths like lib/cmake/ or share/locale/ — without
# it, RPM treats the entry as exclusive file ownership and transactions conflict.
find %{buildroot}%{prefix}/lib -mindepth 1 -maxdepth 1 -type d | sed 's|^%{buildroot}|%dir |' >> %{_builddir}/filelist.txt 2>/dev/null || true
find %{buildroot}%{prefix}/share -mindepth 1 -maxdepth 1 -type d -not -name scls -not -name man -not -name doc | sed 's|^%{buildroot}|%dir |' >> %{_builddir}/filelist.txt 2>/dev/null || true
{% endif %}

%post
{% for cmd in library_symlink_fixes %}
{{ cmd }}
{% endfor %}

# Update registry with pkg-config flags if .pc file exists. Scope
# PKG_CONFIG_PATH to the SCLS prefix so we don't pick up host-system .pc
# files that happen to share a name. lib/pkgconfig resolves through the
# lib -> lib64 symlink owned by the environment package.
SCLS_PCPATH="%{prefix}/lib/pkgconfig"
if PKG_CONFIG_PATH="$SCLS_PCPATH" pkg-config --exists {{ package_name }} 2>/dev/null; then
    PC_CFLAGS=$(PKG_CONFIG_PATH="$SCLS_PCPATH" pkg-config --cflags {{ package_name }} 2>/dev/null || echo "")
    PC_LDFLAGS=$(PKG_CONFIG_PATH="$SCLS_PCPATH" pkg-config --libs {{ package_name }} 2>/dev/null || echo "")
    # Sanity: if the upstream .pc baked the rpmbuild BUILDROOT path,
    # don't propagate it into the registry — leave the spec-time defaults
    # already written above in place. We only check for BUILDROOT/ here
    # because %post runs at the live install prefix on the target host,
    # so substrings like /work/ or .destdir/ would be the user's real
    # prefix, not staging leakage. (build_common.write_registry_entry
    # applies a wider marker set, gated on staging mode, for the DEB and
    # unix-install paths.)
    case "$PC_CFLAGS$PC_LDFLAGS" in
        *BUILDROOT/*)
            echo "scls: dropping leaked BUILDROOT path from {{ package_name }} pkg-config flags" >&2
            PC_CFLAGS=""
            PC_LDFLAGS=""
            ;;
    esac
    if [ -n "$PC_CFLAGS" ] || [ -n "$PC_LDFLAGS" ]; then
        # Mirror build_common.add_rpath_for_libdirs: every -L<dir> gets a
        # matching -Wl,-rpath,<dir> so binaries linking against this
        # package don't need LD_LIBRARY_PATH at runtime.
        PC_LDFLAGS_AUG="$PC_LDFLAGS"
        for libdir in $(echo "$PC_LDFLAGS" | tr ' ' '\n' | sed -n 's/^-L//p'); do
            case " $PC_LDFLAGS_AUG " in
                *" -Wl,-rpath,$libdir "*) ;;
                *) PC_LDFLAGS_AUG="$PC_LDFLAGS_AUG -Wl,-rpath,$libdir" ;;
            esac
        done
        # Rewrite cflags/ldflags/has_pc_file in the registry YAML using
        # awk (POSIX, always available — avoids adding a python3 runtime
        # dep, and sidesteps sed delimiter escaping for | & / in flags).
        REG=%{prefix}/share/scls/registry/{{ package_name }}.yaml
        TMP=$(mktemp) && \
        PC_CFLAGS="$PC_CFLAGS" PC_LDFLAGS="$PC_LDFLAGS_AUG" \
            awk '
                /^cflags:/      { print "cflags: " ENVIRON["PC_CFLAGS"]; next }
                /^ldflags:/     { print "ldflags: " ENVIRON["PC_LDFLAGS"]; next }
                /^has_pc_file:/ { print "has_pc_file: true"; next }
                { print }
            ' "$REG" > "$TMP" && mv "$TMP" "$REG"
    fi
fi


#######################################################################
# SCLS {{ flavor.name }} - {{ package_name }}                        #
#######################################################################

%define prefix {{ prefix }}
%define scls_name {{ scls_name }}

{% if flavor.nvidia %}
%define cuda {{ cuda_path }}
%define gpu {{ gpu_target }}
{% endif %}

Name:           %{scls_name}
Version:        {{ version }}
Release:        {{ release }}%{?dist}
Summary:        {{ description | truncate(70) }}

License:        {{ license }}
URL:            {{ homepage }}
Source0:        {{ source_url }}
{% for patch in patches %}
Patch{{ patch.number }}:         {{ patch.file }}
{% endfor %}

# Build requirements
{% for req in build_requires %}
BuildRequires:  {{ req }}
{% endfor %}

# Runtime requirements
{% for req in requires %}
Requires:       {{ req }}
{% endfor %}

%description
{{ description }}

{% for subpkg in subpackages %}
#######################################################################
# Subpackage: {{ subpkg.name }}
#######################################################################
%package -n {{ subpkg.rpm_name }}
Summary:        {{ subpkg.summary }}
{% for req in subpkg.requires %}
Requires:       {{ req }}
{% endfor %}

%description -n {{ subpkg.rpm_name }}
{{ subpkg.description }}

{% endfor %}
%prep
%setup -q -n {{ package_name }}-{{ version }}
{% for patch in patches %}
{% if patch.strip == 1 %}
%patch{{ patch.number }} -p1
{% else %}
%patch{{ patch.number }} -p{{ patch.strip }}
{% endif %}
{% endfor %}

%build
# Pre-build setup (Intel OneAPI, NVIDIA HPC SDK, etc.)
{% for setup_cmd in pre_build_setup %}
{{ setup_cmd }}
{% endfor %}

{{ path_setup }}

# Setup environment
{% if features.mpi %}
export CC=mpicc
export CXX=mpicxx
export FC=mpifort
export F77=mpifort
{% else %}
export CC={{ flavor.compilers.cc }}
export CXX={{ flavor.compilers.cxx }}
export FC={{ flavor.compilers.fc }}
export F77={{ flavor.compilers.fc }}
{% endif %}

export CFLAGS="{{ cflags }}"
export CXXFLAGS="{{ cxxflags }}"
export FFLAGS="{{ fflags }}"
export FCFLAGS="{{ fcflags }}"
export LDFLAGS="{{ ldflags }}"

# Configure-specific environment variables
{% for env_var in configure_env_vars %}
{% if env_var.operation == 'append' %}
export {{ env_var.name }}="${{ env_var.name }}:{{ env_var.value }}"
{% elif env_var.operation == 'remove' %}
# Remove operation for {{ env_var.name }} - needs manual implementation
export {{ env_var.name }}="${{ env_var.name }}"
{% else %}
export {{ env_var.name }}="{{ env_var.value }}"
{% endif %}
{% endfor %}

{% if configure_type == 'autotools' %}
{% if configure_pre_commands %}
# Pre-configure commands
{% for cmd in configure_pre_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

{{ direct_configure_command }}

{% if configure_post_commands %}
# Post-configure commands
{% for cmd in configure_post_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

{{ make_command }}

{% elif configure_type == 'cmake' %}
%cmake \
{% for arg in cmake_args %}
    {{ arg }}{% if not loop.last %} \{% endif %}

{% endfor %}

%cmake_build

{% elif configure_type == 'custom' %}
# Custom configuration system
{% if recipe.configure.command is defined %}
{{ recipe.configure.command }} \
{% else %}
./config \
{% endif %}
{% for arg in configure_args %}
    {{ arg }}{% if not loop.last %} \{% endif %}

{% endfor %}

{{ make_command }}

{% elif configure_type == 'none' %}
# No configure step - direct build
{% if parallel_build %}
make %{?_smp_mflags} PREFIX=%{prefix}
{% else %}
make PREFIX=%{prefix}
{% endif %}

{% endif %}

%check
# Ensure our binaries are still in PATH for tests
{{ path_setup }}

{% if test_commands %}
{% for cmd in test_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

%install
{% if install_pre_commands %}
# Pre-install commands
{% for cmd in install_pre_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

{% if configure_type == 'autotools' %}
%make_install
{% elif configure_type == 'cmake' %}
%cmake_install
{% else %}
make install DESTDIR=%{buildroot}
{% endif %}

{% if install_post_commands %}
# Post-install commands
{% for cmd in install_post_commands %}
{{ cmd }}
{% endfor %}
{% endif %}

%post
{% for cmd in library_symlink_fixes %}
{{ cmd }}
{% endfor %}

# Remove libtool archives
find %{buildroot} -name '*.la' -delete 2>/dev/null || true

# Remove info directory file - managed by system
rm -rf %{buildroot}%{prefix}/share/info

# Create SCLS registry entry
mkdir -p %{prefix}/share/scls/registry
cat > %{prefix}/share/scls/registry/{{ package_name }}.yaml << 'EOF'
name: {{ package_name }}
version: {{ version }}
dependencies:
{% for dep in package_dependencies %}
  - {{ dep }}
{% endfor %}
cflags: -I%{prefix}/include
ldflags: -L%{prefix}/lib -Wl,-rpath,%{prefix}/lib
features:
  fortran: {{ 'true' if features.fortran else 'false' }}
  openmp: {{ 'true' if features.openmp else 'false' }}
  mpi: {{ 'true' if features.mpi else 'false' }}
  math: {{ 'true' if features.math else 'false' }}
has_pc_file: false
EOF

# Update registry with pkg-config flags if .pc file exists
if pkg-config --exists {{ package_name }} 2>/dev/null; then
    PC_CFLAGS=$(pkg-config --cflags {{ package_name }} 2>/dev/null || echo "")
    PC_LDFLAGS=$(pkg-config --libs {{ package_name }} 2>/dev/null || echo "")
    sed -i "s|^cflags:.*|cflags: $PC_CFLAGS|" %{prefix}/share/scls/registry/{{ package_name }}.yaml
    sed -i "s|^ldflags:.*|ldflags: $PC_LDFLAGS|" %{prefix}/share/scls/registry/{{ package_name }}.yaml
    sed -i "s|^has_pc_file:.*|has_pc_file: true|" %{prefix}/share/scls/registry/{{ package_name }}.yaml
fi

%postun
# Remove SCLS registry entry on uninstall
rm -f %{prefix}/share/scls/registry/{{ package_name }}.yaml 2>/dev/null || true

%files
{% for file in files %}
{{ file }}
{% endfor %}

{% for subpkg in subpackages %}
%files -n {{ subpkg.rpm_name }}
{% for file_pattern in subpkg.files %}
%{prefix}/{{ file_pattern }}
{% endfor %}

{% endfor %}
%changelog
{% if changelog %}
{{ changelog }}
{% else %}
* {{ changelog_date }} Christian Messe <cmesse@lbl.gov> - {{ version }}-{{ release }}
- Initial package for {{ flavor.name }} flavor
{% if patches %}
- Applied {{ patches|length }} patch(es):
{% for patch in patches %}
  - {{ patch.file }}{% if patch.strip != 1 %} (-p{{ patch.strip }}){% endif %}
{% endfor %}
{% endif %}
{% endif %}
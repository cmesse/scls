[scls]
name=Scientific Core Library Stack - $basearch
baseurl=https://belfem.lbl.gov/scls/el$releasever_major/$basearch/
enabled=1
gpgcheck=1
countme=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-SCLS


[scls-source]
name=Scientific Core Library Stack - $basearch - Source
baseurl=https://belfem.lbl.gov/scls/el$releasever_major/source/
enabled=0
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-SCLS
gpgcheck=1

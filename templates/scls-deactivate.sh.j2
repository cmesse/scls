#!/usr/bin/env bash
# SCLS Environment Deactivation Script
# Generated by scls-environment
#
# This file is SOURCED under bash or zsh; keep it free of bashisms
# (see scls-activate.sh.j2 for the rules).

if [ -z "${SCLS:-}" ]; then
    echo "SCLS environment is not active"
    return 0 2>/dev/null || exit 0
fi

# See scls-activate.sh.j2: function scope lets zsh use `emulate -L sh` locally.
_scls_deactivate() {
    if [ -n "${ZSH_VERSION:-}" ] && command -v emulate >/dev/null 2>&1; then
        emulate -L sh
    fi

    # Remove every entry of a colon-separated variable that starts with a prefix,
    # or equals the prefix without its trailing slash (CMAKE_PREFIX_PATH carries
    # the bare root). Usage: _scls_remove_from_var VAR /literal/prefix/
    _scls_remove_from_var() {
        _scls_var=$1
        _scls_pfx=$2
        eval "_scls_old=\"\${$_scls_var:-}\""
        if [ -n "$_scls_old" ]; then
            _scls_new=""
            _scls_rest="$_scls_old:"
            while [ -n "$_scls_rest" ]; do
                _scls_item="${_scls_rest%%:*}"
                _scls_rest="${_scls_rest#*:}"
                case "$_scls_item" in
                    "") ;;
                    "$_scls_pfx"*) ;;
                    "${_scls_pfx%/}") ;;
                    *) _scls_new="${_scls_new:+$_scls_new:}$_scls_item" ;;
                esac
            done
            export "$_scls_var"="$_scls_new"
        fi
        unset _scls_var _scls_pfx _scls_old _scls_new _scls_rest _scls_item
    }

    # Remove SCLS paths from environment (canonical tree and this install's prefix)
    for _scls_v in PATH PKG_CONFIG_PATH CMAKE_PREFIX_PATH LD_LIBRARY_PATH DYLD_LIBRARY_PATH; do
        _scls_remove_from_var "$_scls_v" "/opt/scls/"
        _scls_remove_from_var "$_scls_v" "$SCLS/"
    done
    unset _scls_v

    # Remember flavor for message
    _scls_old_flavor="${SCLS_FLAVOR:-unknown}"

    # Unset SCLS-specific variables
    unset SCLS
    unset SCLS_FLAVOR
    unset PETSC_DIR
    unset PETSC_ARCH
    unset SLEPC_DIR
    unset MPI_HOME

    # Clean up helper functions
    unset -f _scls_remove_from_var
    unset -f _scls_add_to_var 2>/dev/null || :   # zsh returns 1 if it was never defined

    echo "SCLS $_scls_old_flavor deactivated"
    unset _scls_old_flavor
}
_scls_deactivate
unset -f _scls_deactivate

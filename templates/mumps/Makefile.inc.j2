########################################################################
#              SCLS Makefile.inc for MUMPS                             #
#              Generated by SCLS build system                          #
########################################################################

VERSION = {{ version }}
SOVERSION = {{ version_major }}.{{ version_minor }}

# Compiler and Archiver Settings
CC  = {{ mpicc }}
CXX = {{ mpicxx }}
FC  = {{ mpifort }}
FL  = {{ mpifort }}

# Output flag and rm — required by examples/Makefile (note trailing space)
OUTC = -o{{ ' ' }}
OUTF = -o{{ ' ' }}
RM = /bin/rm -f

# RPATH option. upstream src/Makefile passes it to the links of
# libmumps_common and lib[sd]mumps, and examples/Makefile to the examples.
# On MKL flavors it also names the MKL directories: the three libraries NEED
# libmkl_*, and LIBS (mkl_mpi_linker_flags) carries the prefix rpath only, so
# without this their RUNPATH had no MKL directory and `ldd -r libdmumps.so`
# reported libmkl_* as not found (R9 mkl, 2026-10-04; mumps 5.9.1-3).
{% if math_provider == 'mkl' %}
RPATH_OPT = -Wl,-rpath,{{ prefix }}/lib -Wl,-rpath,{{ mklroot }}/lib/intel64 -Wl,-rpath,{{ mklroot }}/lib
{% else %}
RPATH_OPT = -Wl,-rpath,{{ prefix }}/lib
{% endif %}

# BLAS library reference used by examples/Makefile
LIBBLAS =

{% if shared_libs %}
AR = {{ mpifort }} -shared -o
RANLIB = echo
LIBEXT = {{ lib_ext }}
LIBEXT_SHARED = {{ lib_ext }}
SHARED_OPT = -shared
{% if platform == 'macos' %}
SONAME = -install_name
{% else %}
SONAME = -soname
{% endif %}
{% else %}
AR = {{ ar }} cru
RANLIB = ranlib
LIBEXT = .a
LIBEXT_SHARED = .so
SONAME = -soname
{% endif %}

# Optimization Flags
{% if compiler_family == 'gnu' %}
OPTF = {{ fcflags }} {{ openmp_flag }} -fallow-argument-mismatch {{ oflags }}
OPTC = {{ cflags }} {{ openmp_flag }} {{ oflags }}
OPTL = {{ fcflags }} {{ openmp_flag }} -fallow-argument-mismatch
{% else %}
OPTF = {{ fcflags }} {{ openmp_flag }} {{ oflags }}
OPTC = {{ cflags }} {{ openmp_flag }} {{ oflags }}
OPTL = {{ fcflags }} {{ openmp_flag }}
{% endif %}

# Library Paths
LPORDDIR = $(topdir)/PORD/lib/
LPORD    = -L$(LPORDDIR) -lpord

# ORDERINGS
ORDERINGSF = -Dscotch -Dmetis -Dpord -Dptscotch -Dparmetis
ORDERINGSC = -Dscotch -Dmetis -Dpord -Dptscotch -Dparmetis
IORDERINGSF = -I{{ prefix }}/include -I$(topdir)/PORD/include
IORDERINGSC = -I{{ prefix }}/include -I$(topdir)/PORD/include
LORDERINGS  = -lparmetis -lmetis -lpord -lptesmumps -lptscotch -lptscotcherr -lscotch -lscotcherr

# Library Settings
{% if math_provider == 'mkl' %}
LIBPAR = {{ mkl_mpi_linker_flags }}
LIBSEQ = {{ mkl_linker_flags }} -L$(topdir)/libseq -lmpiseq
LIBS   = {{ ldflags }} {{ mkl_mpi_linker_flags }} -lpthread
{% else %}
LIBPAR = {{ scalapack_libs }} {{ lapack_libs }} {{ blas_libs }}
LIBSEQ = {{ lapack_libs }} {{ blas_libs }} -L$(topdir)/libseq -lmpiseq
LIBS   = {{ ldflags }} {{ scalapack_libs }} {{ lapack_libs }} {{ blas_libs }} -lpthread
{% endif %}

LIBOTHERS = -lpthread
LIBSEQNEEDED =

# Preprocessor Definitions
{% if interface == 'ilp64' %}
CDEFS = -DAdd_ -DINTSIZE64
{% else %}
CDEFS = -DAdd_
{% endif %}

# Includes
INCS = -I{{ prefix }}/include -I$(topdir)/PORD/include

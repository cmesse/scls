#!/usr/bin/env bash
# SCLS Environment Activation Script
# Flavor: {{ flavor.name }}
# Generated by scls-environment
#
# This file is SOURCED, not executed, and must work under both bash and zsh
# (zsh is the macOS login shell). Keep it free of bashisms: no BASH_SOURCE-only
# self-location, no `read -a`, no `${!var}` indirection, no arrays.

# Determine SCLS root from script location. bash exposes the sourced file in
# BASH_SOURCE; zsh exposes it through the %x prompt escape. Anything else gets
# a loud failure instead of a silently wrong root.
if [ -n "${BASH_SOURCE[0]:-}" ]; then
    _scls_self="${BASH_SOURCE[0]}"
elif [ -n "${ZSH_VERSION:-}" ]; then
    # eval keeps the zsh-only expansion out of every bash parser's sight.
    eval '_scls_self="${(%):-%x}"'
else
    echo "scls: share/scls/activate must be sourced from bash or zsh" >&2
    return 1 2>/dev/null || exit 1
fi
# cd's stdout is discarded: a zsh chpwd hook that prints would otherwise end
# up inside SCLS. A failed cd is an error, not an empty root.
if ! SCLS="$(cd "$(dirname "$_scls_self")/../.." >/dev/null 2>&1 && pwd)"; then
    echo "scls: cannot resolve the SCLS root from $_scls_self" >&2
    unset _scls_self SCLS
    return 1 2>/dev/null || exit 1
fi
export SCLS
unset _scls_self

# Everything below runs inside a function so that, under zsh, `emulate -L sh`
# can give it plain POSIX semantics (no globsubst, rc_expand_param, nomatch,
# extended_glob ...) without touching the caller's options. Exports persist.
_scls_activate() {
    if [ -n "${ZSH_VERSION:-}" ] && command -v emulate >/dev/null 2>&1; then
        emulate -L sh
    fi

    # Remove every entry of a colon-separated variable that starts with a prefix,
    # or equals the prefix without its trailing slash (CMAKE_PREFIX_PATH carries
    # the bare root). Usage: _scls_remove_from_var VAR /literal/prefix/
    _scls_remove_from_var() {
        _scls_var=$1
        _scls_pfx=$2
        eval "_scls_old=\"\${$_scls_var:-}\""
        if [ -n "$_scls_old" ]; then
            _scls_new=""
            _scls_rest="$_scls_old:"
            while [ -n "$_scls_rest" ]; do
                _scls_item="${_scls_rest%%:*}"
                _scls_rest="${_scls_rest#*:}"
                case "$_scls_item" in
                    "") ;;
                    "$_scls_pfx"*) ;;
                    "${_scls_pfx%/}") ;;
                    *) _scls_new="${_scls_new:+$_scls_new:}$_scls_item" ;;
                esac
            done
            export "$_scls_var"="$_scls_new"
        fi
        unset _scls_var _scls_pfx _scls_old _scls_new _scls_rest _scls_item
    }

    # Prepend a path to a colon-separated variable unless it is already present.
    # Usage: _scls_add_to_var VAR /path
    _scls_add_to_var() {
        _scls_var=$1
        _scls_path=$2
        eval "_scls_old=\"\${$_scls_var:-}\""
        case ":$_scls_old:" in
            *":$_scls_path:"*) ;;
            *)
                if [ -z "$_scls_old" ]; then
                    export "$_scls_var"="$_scls_path"
                else
                    export "$_scls_var"="$_scls_path:$_scls_old"
                fi
                ;;
        esac
        unset _scls_var _scls_path _scls_old
    }

    # Remove any existing SCLS paths (allows switching between flavors). Both the
    # canonical /opt/scls/ tree and this install's own prefix are pruned, so a
    # custom-prefix flavor is cleaned up too.
    for _scls_v in PATH PKG_CONFIG_PATH CMAKE_PREFIX_PATH LD_LIBRARY_PATH DYLD_LIBRARY_PATH; do
        _scls_remove_from_var "$_scls_v" "/opt/scls/"
        _scls_remove_from_var "$_scls_v" "$SCLS/"
    done
    unset _scls_v

    # Core paths (always set if directories exist)
    [ -d "$SCLS/bin" ] && _scls_add_to_var PATH "$SCLS/bin"
    [ -d "$SCLS/lib/pkgconfig" ] && _scls_add_to_var PKG_CONFIG_PATH "$SCLS/lib/pkgconfig"
    [ -d "$SCLS/lib/cmake" ] && _scls_add_to_var CMAKE_PREFIX_PATH "$SCLS"

    # Package-specific environment variables (only if package is installed)
    # Check registry for installed packages

    # PETSc
    if [ -f "$SCLS/share/scls/registry/petsc.yaml" ]; then
        export PETSC_DIR="$SCLS"
        export PETSC_ARCH=""
    fi

    # SLEPc (depends on PETSc)
    if [ -f "$SCLS/share/scls/registry/slepc.yaml" ]; then
        export SLEPC_DIR="$SCLS"
    fi

    # MPI (OpenMPI or MPICH)
    if [ -f "$SCLS/share/scls/registry/openmpi.yaml" ]; then
        export MPI_HOME="$SCLS"
        export PRTE_MCA_hwloc_default_binding_policy=none
    elif [ -f "$SCLS/share/scls/registry/mpich.yaml" ]; then
        export MPI_HOME="$SCLS"
        export HYDRA_BINDING=none
    fi

    # Read flavor from config
    _scls_config="$SCLS/share/scls/config.yaml"
    if [ -f "$_scls_config" ]; then
        SCLS_FLAVOR=$(grep '^flavor:' "$_scls_config" | cut -d' ' -f2)
        export SCLS_FLAVOR
    fi
    unset _scls_config

    # The helper functions stay defined in the caller's shell (deactivate.sh
    # redefines the one it needs). Users shouldn't call them directly.
    clear
    echo "     ▜"
    echo " ▛▘▛▘▐ ▛▘    Scientific Core Library Stack 2026 [${SCLS_FLAVOR:-unknown}]"
    echo " ▄▌▙▖▐▖▄▌    Type 'scls help' for commands and environment details."
    echo ""
}
_scls_activate
unset -f _scls_activate

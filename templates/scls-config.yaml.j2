# SCLS Installation Configuration
# Generated by scls-environment on {{ build_date }}

flavor: {{ flavor.name }}
description: "{{ flavor.description }}"
platform: {{ flavor.platform }}
prefix: {{ prefix }}

# Build metadata
build_date: {{ build_date }}
scls_version: "{{ scls_version }}"

# Math library configuration
math:
  linalg: {{ flavor.math.linalg | default('reference') }}
  threading: {{ flavor.math.threading | default('sequential') }}
  interface: {{ flavor.math.interface | default('lp64') }}

# Compilers used to build packages
compilers:
  cc: {{ flavor.compilers.cc | default('gcc') }}
  cxx: {{ flavor.compilers.cxx | default('g++') }}
  fc: {{ flavor.compilers.fc | default('gfortran') }}

--- a/libmetis/CMakeLists.txt
+++ b/libmetis/CMakeLists.txt
@@ -5,7 +5,21 @@
 file(GLOB metis_sources *.c)

 # Build libmetis.
-add_library(metis ${METIS_LIBRARY_TYPE} ${metis_sources})
+# Link GKlib statically into libmetis so all symbols are in one library.
+# This preserves the single-library interface from METIS 5.1.0.
+find_library(GKLIB_LIBRARY GKlib PATHS ${GKLIB_PATH}/lib ${CMAKE_INSTALL_PREFIX}/lib NO_DEFAULT_PATH)
+add_library(metis ${METIS_LIBRARY_TYPE} ${metis_sources})
+set_target_properties(metis PROPERTIES SOVERSION 0)
+if(GKLIB_LIBRARY AND SHARED)
+  if(APPLE)
+    target_link_libraries(metis PRIVATE "-Wl,-force_load,${GKLIB_LIBRARY}" m)
+  else()
+    target_link_libraries(metis PRIVATE
+      -Wl,--whole-archive ${GKLIB_LIBRARY} -Wl,--no-whole-archive m)
+  endif()
+elseif(UNIX)
+  target_link_libraries(metis m)
+endif()

 if(METIS_INSTALL)
   install(TARGETS metis
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,11 @@ set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${METIS_COPTIONS}")
 include_directories(build/xinclude)
 include_directories(${GKLIB_PATH}/include)
 include_directories(${CMAKE_INSTALL_PREFIX}/include)
+if(GKLIB_PATH)
+  # Force the include path instead of relying on CMake's implicit include
+  # detection, which can omit prefix includes under the macOS GCC sysroot.
+  add_compile_options("-I${GKLIB_PATH}/include")
+endif()
 

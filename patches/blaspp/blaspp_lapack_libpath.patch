--- a/cmake/LAPACKFinder.cmake
+++ b/cmake/LAPACKFinder.cmake
@@ -100,6 +100,17 @@
 # ESSL lacks [cz]symv, [cz]syr.

 unset( LAPACK_FOUND CACHE )
+
+# Add include and library search paths explicitly so try_compile / try_run can
+# resolve MKL and other non-system LAPACK providers.  CMAKE_INCLUDE_PATH and
+# CMAKE_LIBRARY_PATH may be ;-separated lists, so emit one -I/-L per entry.
+foreach (_dir IN LISTS CMAKE_INCLUDE_PATH)
+    set( CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -I${_dir}" )
+endforeach()
+foreach (_dir IN LISTS CMAKE_LIBRARY_PATH)
+    set( CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -L${_dir}" )
+endforeach()
+
 unset( lapackpp_defs_ CACHE )

 foreach (lapack_libs IN LISTS lapack_libs_list)

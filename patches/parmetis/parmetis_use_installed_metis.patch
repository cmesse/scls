--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -8,23 +8,53 @@
 # included from metis/libmetis/.
 execute_process(COMMAND ${CMAKE_COMMAND} -E create_symlink ${METIS_PATH} metis)
 
-# Search for MPI.
-# GK commented this out as it seems to be creating problems
-# include(FindMPI)
-# if(NOT MPI_FOUND)
-#   message(FATAL_ERROR "mpi is not found")
-# endif()
-# set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${MPI_COMPILE_FLAGS}")
+set(METIS_PATH "${CMAKE_CURRENT_SOURCE_DIR}/metis" CACHE PATH "path to METIS headers")
+set(GKLIB_PATH "${METIS_PATH}/GKlib" CACHE PATH "path to GKlib headers")
 
+# Find installed METIS library
+find_library(METIS_LIBRARY metis HINTS ${CMAKE_PREFIX_PATH}/lib)
+if(NOT METIS_LIBRARY)
+  message(FATAL_ERROR "Could not find installed libmetis. Set CMAKE_PREFIX_PATH.")
+endif()
+message(STATUS "Found METIS library: ${METIS_LIBRARY}")
+
+# Setup compiler flags (simplified from GKlibSystem.cmake)
+include(CheckFunctionExists)
+include(CheckIncludeFile)
+
+set(GKlib_COPTIONS "-D_FILE_OFFSET_BITS=64 -std=c99 -fno-strict-aliasing -fPIC -DNDEBUG -DNDEBUG2")
+set(GKlib_COPTIONS "${GKlib_COPTIONS} -Wall -pedantic -Wno-unused-variable -Wno-unknown-pragmas")
+
+# Check for features
+check_include_file(execinfo.h HAVE_EXECINFO_H)
+if(HAVE_EXECINFO_H)
+  set(GKlib_COPTIONS "${GKlib_COPTIONS} -DHAVE_EXECINFO_H")
+endif()
+
+check_function_exists(getline HAVE_GETLINE)
+if(HAVE_GETLINE)
+  set(GKlib_COPTIONS "${GKlib_COPTIONS} -DHAVE_GETLINE")
+endif()
+
+# OpenMP support
+option(OPENMP "enable OpenMP support" OFF)
+if(OPENMP)
+  find_package(OpenMP)
+  if(OpenMP_FOUND)
+    set(GKlib_COPTIONS "${GKlib_COPTIONS} -D__OPENMP__ ${OpenMP_C_FLAGS}")
+  endif()
+endif()
+
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${GKlib_COPTIONS}")
+
 # Prepare libraries.
+option(SHARED "build shared library" ON)
 if(SHARED)
   set(ParMETIS_LIBRARY_TYPE SHARED)
 else()
   set(ParMETIS_LIBRARY_TYPE STATIC)
 endif()
 
-include(${GKLIB_PATH}/GKlibSystem.cmake)
